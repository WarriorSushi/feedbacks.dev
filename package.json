{
  "name": "feedbacks-dev",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "overrides": {
      "@hono/node-server": "2.0.10",
      "esbuild": "0.28.1",
      "fast-uri": "3.1.5",
      "hono": "4.12.34",
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @feedbacks/dashboard dev",
    "build": "pnpm --filter @feedbacks/shared build && pnpm --filter @feedbacks/widget build && pnpm --filter @feedbacks/widget-react build && pnpm --filter @feedbacks/widget-vue build && pnpm run widget:copy && pnpm --filter @feedbacks/mcp-server build && pnpm run mcp:pack && pnpm --filter @feedbacks/dashboard build",
    "widget:dev": "pnpm --filter @feedbacks/widget dev",
    "widget:build": "pnpm --filter @feedbacks/widget build",
    "widget:check-size": "node scripts/check-widget-gzip.mjs",
    "dashboard:check-budgets": "node scripts/check-dashboard-route-budgets.mjs",
    "supabase:check": "node scripts/check-supabase-schema.mjs",
    "activation:report": "node scripts/activation-funnel-report.mjs",
    "supabase:types": "supabase gen types typescript --project-id xiiaugllydxxmjbtzfux --schema public > packages/dashboard/src/lib/database.types.ts",
    "widget:copy": "node -e \"const fs=require('fs');const p='packages/dashboard/public/widget';fs.mkdirSync(p,{recursive:true});fs.copyFileSync('packages/widget/dist/widget.js',p+'/latest.js');fs.copyFileSync('packages/widget/dist/widget.js',p+'/v2.js');console.log('Widget copied to public/widget/')\"",
    "hooks:install": "node scripts/setup-git-hooks.mjs",
    "mcp:pack": "node scripts/pack-mcp-server.mjs",
    "dashboard:dev": "pnpm --filter @feedbacks/dashboard dev",
    "dashboard:build": "pnpm --filter @feedbacks/dashboard build",
    "type-check": "pnpm --filter @feedbacks/shared build && pnpm -r --parallel type-check",
    "lint": "pnpm -r --if-present lint",
    "ci:verify": "pnpm type-check && pnpm lint && pnpm build && pnpm widget:check-size && pnpm dashboard:check-budgets",
    "test:unit": "node --experimental-strip-types --test packages/dashboard/tests/unit/**/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:required": "node scripts/check-e2e-env.mjs && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install --with-deps"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "^1.55.0",
    "@supabase/supabase-js": "2.110.0",
    "@types/node": "^22.0.0",
    "sharp": "0.35.3",
    "typescript": "^5.7.0"
  }
}
