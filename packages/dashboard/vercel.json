{
  "installCommand": "cd ../.. && pnpm install",
  "buildCommand": "cd ../.. && pnpm build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/webhook-jobs",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/notification-digests",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/e2e-cleanup",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/account-deletions",
      "schedule": "45 2 * * *"
    },
    {
      "path": "/api/cron/billing-lifecycle",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/cron/early-adopter",
      "schedule": "30 3 * * *"
    }
  ]
}
